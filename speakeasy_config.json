{
  "node": {
    "name": "Speakeasy-Alpha",
    "bandwidth_class": "HIGH_SPEED",
    "sync_interval_sec": 60,
    "announce_interval_sec": 900,
    "max_clients": 15
  },
  "static_peers": [],
  "federation": {
    "auto_discover_peers": true,
    "include_channel_summary_in_announces": true,
    "epoch_bucket_sec": 300,
    "max_sync_history_days": 14,
    "settlement_delay_ms": 350
  },
  "channels": {
    "allowed_channels": [
      "general",
      "parlor",
      "tech"
    ],
    "channel_blocklist": [],
    "max_message_bytes": 200
  },
  "moderation": {
    "accept_channel_requests": true,
    "receive_federated_channel_nominations": true,
    "operator_lxmf_hash": ""
  },
  "storage": {
    "db_filename": "speakeasy_daemon.db",
    "message_ttl_days": 30,
    "max_messages_per_channel": 5000,
    "max_db_mb": 64,
    "prune_interval_hours": 1,
    "vacuum_interval_hours": 24
  },
  "logging": {
    "level": "INFO",
    "log_to_file": true,
    "log_file_path": "~/.reti_speakeasy/logs/daemon.log"
  }
}
